def fmt(v):
    """Formata número no padrão brasileiro (1.234,56); inteiros sem casas decimais."""
    if isinstance(v, (bool, np.bool_)) or isinstance(v, str):
        return str(v)
    if pd.isna(v):
        return "-"
    if float(v).is_integer():
        return f"{int(v):,}".replace(",", ".")
    return f"{v:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


def fmt_p(v):
    """p-valor: notação científica quando muito pequeno."""
    return f"{v:.2e}".replace(".", ",") if v < 0.001 else f"{v:.4f}".replace(".", ",")


