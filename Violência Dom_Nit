# Descobre automaticamente as colunas (o ISP às vezes muda nomes entre versões).
def achar(candidatas, obrigatoria=True):
    for c in candidatas:
        if c in df.columns:
            return c
    if obrigatoria:
        raise KeyError(f"Nenhuma de {candidatas} está na base. Veja a lista de colunas acima.")
    return None


COL_MUN = achar(["fmun", "munic", "municipio", "fmun_nome"])
