# %% 5. REGRESSÃO LINEAR SIMPLES -----------------------------------------------
etapa("5. Regressão linear simples")
RESULTADOS_REG = []   # guarda os resultados para a tabela final


def regressao(x, y, nome):
    """y = a*x + b via mínimos quadrados (scipy.stats.linregress)."""
    r = stats.linregress(x, y)
    log(f"{nome}: a={r.slope:.4f} | b={r.intercept:.2f} | R²={r.rvalue**2:.3f} | p={r.pvalue:.4g}")
    RESULTADOS_REG.append({"Modelo": nome, "Inclinação (a)": r.slope, "Intercepto (b)": r.intercept,
                           "R²": r.rvalue ** 2, "p-valor": r.pvalue,
                           "Significativo (p<0,05)": "Sim" if r.pvalue < 0.05 else "Não"})
    return r


# 5.1 Tendência temporal: ocorrências / tempo (meses)
r_tempo = regressao(df["t"], df["violencia_domestica_proxy"], "tendência violência doméstica")
log(f"Variação estimada: {r_tempo.slope:+.2f} ocorrências por mês, a cada mês que passa "
      f"({12 * r_tempo.slope:+.1f} por ano)")

# 5.2 Projeção dos próximos 12 meses
futuro_t = np.arange(len(df), len(df) + 12)
proj = r_tempo.intercept + r_tempo.slope * futuro_t
datas_fut = pd.date_range(df["data"].iloc[-1] + pd.offsets.MonthBegin(1), periods=12, freq="MS")

fig, ax = plt.subplots(figsize=(11, 5))
ax.plot(df["data"], df["violencia_domestica_proxy"], label="Observado")
ax.plot(df["data"], r_tempo.intercept + r_tempo.slope * df["t"], "r--", label="Reta de regressão")
ax.plot(datas_fut, proj, "g:", label="Projeção 12 meses")
ax.legend(); ax.set_title(f"Regressão linear simples (R² = {r_tempo.rvalue**2:.2f})")
plt.tight_layout()
plt.savefig(f"{PASTA_SAIDA}/03_regressao_tendencia.png", dpi=150)
plt.close()

# 5.3 Relação entre indicadores: feminicídio / lesão corporal (se existir)
if "feminicidio" in df.columns and "lesao_corporal" in df.columns and "feminicidio" not in LIMITADOS:
    r_fem = regressao(df["lesao_corporal"], df["feminicidio"], "feminicídio ~ lesão corporal")
