def sem_acento(txt):
    """Remove acentos e padroniza para minúsculas (ex.: 'Niterói' -> 'niteroi')."""
    txt = unicodedata.normalize("NFKD", str(txt))
    return "".join(c for c in txt if not unicodedata.combining(c)).strip().lower()


def etapa(txt):
    """Título de etapa no console, para o log ficar organizado."""
    print(f"\n>>> {txt}")


def log(msg):
    print(f"    - {msg}")


def baixar_isp(timeout=(10, 60)):
    """Tenta baixar o CSV do ISP sem travar (timeout curto). Retorna True se salvou o arquivo."""
    import requests
    headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                             "(KHTML, like Gecko) Chrome/124.0 Safari/537.36"}
    for url in URLS_ISP:
        try:
            log(f"Tentando baixar: {url}")
            r = requests.get(url, headers=headers, timeout=timeout)
            r.raise_for_status()
            with open(ARQUIVO_LOCAL, "wb") as f:
                f.write(r.content)
            log("Download concluído.")
            return True
        except Exception as e:
            log(f"Falhou ({type(e).__name__}).")
    return False


def pedir_upload_colab():
    """No Colab, abre a janela para enviar o CSV baixado manualmente pelo navegador."""
    try:
        from google.colab import files
    except ImportError:
        return False
    print("\n    Não foi possível baixar automaticamente.")
    print("    1) Baixe o CSV em https://www.ispdados.rj.gov.br (Dados Abertos) pelo seu navegador;")
    print("    2) Envie o arquivo na janela abaixo.\n")
    enviado = files.upload()
    if not enviado:
        return False
    nome = next(iter(enviado))
    with open(ARQUIVO_LOCAL, "wb") as f:
        f.write(enviado[nome])
    return True


def carregar_base():
    """Usa o CSV local (se existir); senão baixa do ISP; senão pede upload. O ISP usa ';' e latin-1."""
    if not os.path.exists(ARQUIVO_LOCAL):
        if not baixar_isp() and not pedir_upload_colab():
            raise FileNotFoundError(
                f"Coloque o CSV do ISP na mesma pasta do código com o nome '{ARQUIVO_LOCAL}'.")
    for enc in ("latin-1", "utf-8"):
        try:
            return pd.read_csv(ARQUIVO_LOCAL, sep=None, engine="python", encoding=enc)
        except UnicodeDecodeError:
            continue
    raise RuntimeError("Não foi possível ler a base: " + ARQUIVO_LOCAL)


