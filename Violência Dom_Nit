def como_texto(tab, com_indice):
    """Converte a tabela em texto já formatado (números no padrão brasileiro)."""
    out = tab.apply(lambda col: col.map(fmt)) if len(tab) else tab.copy()
    return out if com_indice else out.reset_index(drop=True)


def mostrar(titulo, tab, com_indice):
    txt = como_texto(tab, com_indice)
    if len(tab) == 0:
        txt = pd.DataFrame({"": ["(nenhum registro)"]})
    if EM_NOTEBOOK:
        from IPython.display import display, HTML
        estilo = [
            {"selector": "caption", "props": "caption-side: top; font-weight: bold; font-size: 14px; "
                                             "text-align: left; padding: 6px 0;"},
            {"selector": "th", "props": f"background-color: {COR_CABECALHO}; color: #ffffff; "
                                        "padding: 4px 10px; text-align: center;"},
            {"selector": "td", "props": f"background-color: {COR_LINHA_IMPAR}; color: #1f1f1f; "
                                        "padding: 4px 10px; border-bottom: 1px solid #cfc6e0;"},
            {"selector": "tbody tr:nth-child(even) td", "props": f"background-color: {COR_LINHA_PAR};"},
        ]
        sty = txt.style.set_caption(titulo).set_table_styles(estilo).set_properties(**{"text-align": "right"})
        display(sty if com_indice else sty.hide(axis="index"))
    else:
        print("\n" + titulo + "\n" + "-" * len(titulo))
        print(txt.to_string(index=com_indice, justify="center"))


for nome, (titulo, tab, com_indice) in TABELAS.items():
