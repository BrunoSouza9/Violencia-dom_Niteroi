# 2.3 converte indicadores para número; valores negativos são inválidos -> NaN
for nome, col in INDICADORES.items():
    df[nome] = pd.to_numeric(df[col], errors="coerce")
    df.loc[df[nome] < 0, nome] = np.nan

# 2.4 remove duplicatas e ordena no tempo; 1 linha por mês
df = (df.groupby("data", as_index=False)[list(INDICADORES)].sum(min_count=1)
        .sort_values("data").reset_index(drop=True))

# 2.5 trata ausentes: interpolação linear no tempo (e relata quantos eram)
# Só interpolamos séries com poucos ausentes (<=10%). Séries com muitos ausentes (indicador que
# só passou a ser registrado depois) NÃO são preenchidas: preencher criaria zeros falsos.
ausentes = df[list(INDICADORES)].isna().sum()
INCOMPLETAS = [c for c in INDICADORES if ausentes[c] / len(df) > 0.10]
for c in INDICADORES:
