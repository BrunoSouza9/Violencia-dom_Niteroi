            ("série incompleta, mantida SEM preenchimento" if c in INCOMPLETAS else "preenchidos por interpolação"))
completas = [c for c in INDICADORES if c not in INCOMPLETAS]
df[completas] = df[completas].interpolate(limit_direction="both")

# Indicadores "raros": mais de 80% dos meses com valor zero (ex.: feminicídio mensal).
# Para eles, média/z-score/regressão mensal enganam; tratamos separadamente.
RAROS = [c for c in INDICADORES if (df[c].dropna() == 0).mean() > 0.80]
