# %% 4. OUTLIERS (BOXPLOT/IQR E Z-SCORE) ---------------------------------------
etapa("4. Outliers (boxplot/IQR e z-score)")
def outliers_iqr(s):
    q1, q3 = s.quantile([0.25, 0.75])
    iqr = q3 - q1
    if iqr == 0:            # maioria zerada: qualquer valor > 0 viraria "outlier"
        return pd.Series(False, index=s.index)
    return (s < q1 - 1.5 * iqr) | (s > q3 + 1.5 * iqr)


def outliers_z(s, limite=3):
    z = (s - s.mean()) / s.std(ddof=0)
    return z.abs() > limite, z


resumo_out = []
for c in colunas_num:
    flag_iqr = outliers_iqr(df[c])
    flag_z, z = outliers_z(df[c])
    df[f"{c}_out_iqr"], df[f"{c}_zscore"], df[f"{c}_out_z"] = flag_iqr, z, flag_z
    resumo_out.append({"indicador": c, "outliers_IQR": int(flag_iqr.sum()),
                       "outliers_zscore>3": int(flag_z.sum()),
                       "observacao": "evento raro/série incompleta: cautela" if c in LIMITADOS else ""})
